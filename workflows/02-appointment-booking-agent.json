    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst phone = input.phone || '';\nconst name = input.name || phone;\nconst language = input.language || 'ar';\nconst extractedDate = input.extracted_date;\nconst extractedTime = input.extracted_time;\nconst responseToPat = input.response_to_patient || '';\n\nif (!extractedDate || !extractedTime) {\n  return [{ json: { phone, name, language, response_to_patient: responseToPat, ready: 'no' }}];\n}\n\nconst appointmentDatetime = extractedDate + 'T' + extractedTime + ':00+02:00';\nreturn [{ json: { phone, name, language, appointment_datetime: appointmentDatetime, response_to_patient: responseToPat, ready: 'yes' }}];"
      },
