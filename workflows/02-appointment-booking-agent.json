    {
      "parameters": {
        "jsCode": "const booked = $input.first().json;\nconst prep = $('Prepare Booking').first().json;\nconst lang = prep.language || 'ar';\nconst phone = prep.phone;\n\nif (!booked.id) {\n  const txt = lang === 'ar' ? 'عذراً، لم نتمكن من تأكيد الحجز. يرجى المحاولة مرة أخرى.' : 'Sorry, we could not confirm your booking. Please try again.';\n  return [{ json: { phone, reply_text: txt, new_state: 'booking', new_context: {} }}];\n}\n\nconst dateStr = booked.appointment_date || '';\nconst timeStr = booked.appointment_time ? String(booked.appointment_time).substring(0, 5) : '';\n\nconst msg = lang === 'ar'\n  ? 'تم تأكيد موعدك! \\nالتاريخ: ' + dateStr + '\\nالوقت: ' + timeStr + '\\nرقم الموعد: ' + booked.id\n  : 'Your appointment is confirmed!\\nDate: ' + dateStr + '\\nTime: ' + timeStr + '\\nBooking ID: ' + booked.id;\n\nreturn [{ json: { phone, reply_text: msg, new_state: 'booked', new_context: { appointment_id: booked.id } }}];"
      },
      "id": "code-book-reply",
      "name": "Booking Confirm Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
