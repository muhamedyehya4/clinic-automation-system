    {
      "parameters": {
        "jsCode": "const groqRaw = $input.first().json;\nconst source = $('Build groq prompt').first().json;\nconst phone = source.phone;\nconst name = source.name;\nconst state = source.state;\nconst context_data = source.context_data || {};\nlet text = groqRaw && groqRaw.choices && groqRaw.choices[0]\n  ? (groqRaw.choices[0].message && groqRaw.choices[0].message.content) || '{}'\n  : '{}';\ntext = text.replace(/^```json\\n?/, '').replace(/```$/, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(text); }\ncatch(e) { parsed = { intent: 'unclear', language: 'ar', response_to_patient: 'عذراً، لم أفهم. هل يمكنك التوضيح؟' }; }\nreturn [{ json: {\n  phone, name, state, context_data,\n  intent: parsed.intent || 'unclear',\n  language: parsed.language || 'ar',\n  extracted_date: parsed.extracted_date || null,\n  extracted_time: parsed.extracted_time || null,\n  response_to_patient: parsed.response_to_patient || 'كيف يمكنني مساعدتك؟'\n} }];"
      },
