    },
    {
      "parameters": {
        "jsCode": "const lookupResult = $input.first().json;\nconst groqData = $('Parse Groq Response').first().json;\nconst apt = typeof lookupResult.appointment === 'string' ? JSON.parse(lookupResult.appointment) : (lookupResult.appointment || {});\nconst phone = groqData.phone;\nconst language = groqData.language || 'ar';\nconst newDate = groqData.extracted_date;\nconst newTime = groqData.extracted_time;\n\nif (!apt.id) {\n  const txt = language === 'ar' ? 'لم نجد موعداً محجوزاً لك. هل تريد حجز موعد جديد؟' : 'No existing appointment found. Would you like to book a new one?';\n  return [{ json: { phone, language, reply_text: txt, ready: 'no', new_state: 'booking', new_context: {} }}];\n}\n\nif (!newDate || !newTime) {\n  const txt = language === 'ar'\n    ? 'لديك موعد في ' + apt.apt_date + ' الساعة ' + apt.apt_time + '. ما هو التاريخ والوقت الجديد؟'\n    : 'You have an appointment on ' + apt.apt_date + ' at ' + apt.apt_time + '. What date and time would you like?';\n  return [{ json: { phone, language, reply_text: txt, ready: 'no', new_state: 'reschedule_pending', new_context: { appointment_id: apt.id } }}];\n}\n\nreturn [{ json: { phone, language, appointment_id: apt.id, new_date: newDate, new_time: newTime, ready: 'yes', new_state: 'rescheduled', new_context: {} }}];"
      },
