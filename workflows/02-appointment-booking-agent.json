    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  (SELECT row_to_json(a) FROM (\n    SELECT id, appointment_date::text AS apt_date, to_char(appointment_time, 'HH24:MI') AS apt_time\n    FROM appointments\n    WHERE patient_phone = $1 AND status = 'scheduled'\n    ORDER BY appointment_date ASC, appointment_time ASC LIMIT 1\n  ) a),\n  '{\"id\": null}'::json\n) AS appointment",
        "options": {
          "queryReplacement": "={{ [$json.phone] }}"
        }
      },
