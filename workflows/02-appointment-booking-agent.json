    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst phone = input.phone || '';\nconst message = input.message || '';\nconst name = input.name || phone;\nconst state = input.state || 'new';\nconst context_data = input.context_data || {};\n\nconst today = new Date().toISOString().split('T')[0];\n\nconst sysPrompt = 'You are a dental clinic receptionist in Cairo. Today is ' + today + '. Analyze the patient message and respond in the same language (Arabic or English). Return ONLY valid JSON with: intent (book_new/reschedule/cancel/unclear), language (ar/en), extracted_date (YYYY-MM-DD if date mentioned else null), extracted_time (HH:MM 24h if time mentioned else null), response_to_patient (reply in patient language; if date/time missing for booking ask for them).';\n\nconst userMsg = 'Patient: ' + name + ' | Phone: ' + phone + ' | State: ' + state + ' | Message: ' + message;\n\nconst groqBody = JSON.stringify({\n  model: 'llama-3.3-70b-versatile',\n  messages: [\n    { role: 'system', content: sysPrompt },\n    { role: 'user', content: userMsg }\n  ],\n  temperature: 0.3,\n  max_tokens: 500,\n  response_format: { type: 'json_object' }\n});\n\nreturn [{ json: { phone, message, name, state, context_data, groqBody } }];"
      },
      "id": "code-2",
      "name": "Build groq prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
